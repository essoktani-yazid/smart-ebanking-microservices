# ==============================================================================
# Smart E-Banking Microservices - Local Environment Template
# Copy this file to .env and configure your local credentials.
# NEVER commit your actual .env file to Git!
# ==============================================================================

# Google Gemini API Key (obtain from https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here

# Telegram Bot Token & Username (obtain from @BotFather)
TELEGRAM_TOKEN=your_telegram_bot_token_here
TELEGRAM_USERNAME=ebank1234_bot

# Discord Bot Token (obtain from https://discord.com/developers/applications)
DISCORD_TOKEN=your_discord_bot_token_here
